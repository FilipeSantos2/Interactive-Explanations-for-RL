R <- read.table("exercises2_1.txt", header = TRUE)
lm.out = lm(R$time~R$n) #Apply Linear Regression
summary(lm.out) #Check Coefficients (Intercept and Slope)
plot(R$time~R$n)
abline(lm.out) #y=-496.600+72.450x -> Plot Regression Line
m = mean(R$time)
SST = (R$time[1] - m)**2 + (R$time[2] - m)**2 + (R$time[3] - m)**2 +
(R$time[4] - m)**2 + (R$time[5] - m)**2
SST = (R$time[1] - m)**2 + (R$time[2] - m)**2 + (R$time[3] - m)**2 +
(R$time[4] - m)**2 + (R$time[5] - m)**2
a = -496.600
b = 72.450
SSE = (R$time[1] - (a+b*R$n[1]))**2 + (R$time[2] - (a+b*R$n[2]))**2+
(R$time[3] - (a+b*R$n[3]))**2 + (R$time[4] - (a+b*R$n[4]))**2 +
(R$time[5] - (a+b*R$n[5]))**2
R_Squared = (SST - SSE)/SST
R_Correlation = sqrt(R_Squared)
#b
corrected_data = R
corrected_data$time = rev(corrected_data$time)
lm.out2 = lm(corrected_data$time~corrected_data$n) #Apply Linear Regression
summary(lm.out2) #Check Coefficients (Intercept and Slope)
plot(corrected_data$time~corrected_data$n)
abline(lm.out2) #y=1242.200+(-72.450)x -> Plot Regression Line -> Negative Correlation
#a
D <- read.table("exercises2_2.txt", header = TRUE)
lm.out3 = lm(D$time~D$queries) #Apply Linear Regression
summary(lm.out3) #Check Coefficients (Intercept and Slope)
plot(D$time~D$queries)
abline(lm.out3) #y=-47.3+3.77x -> Plot Regression Line
m2 = mean(D$time)
SST2 = (D$time[1] - m2)**2 + (D$time[2] - m2)**2 + (D$time[3] - m2)**2 +
(D$time[4] - m2)**2 + (D$time[5] - m2)**2
a2 = -47.3
b2 = 3.77
SSE2 = (D$time[1] - (a2+b2*D$queries[1]))**2 +
(D$time[2] - (a2+b2*D$queries[2]))**2 +
(D$time[3] - (a2+b2*D$queries[3]))**2 +
(D$time[4] - (a2+b2*D$queries[4]))**2 +
(D$time[5] - (a2+b2*D$queries[5]))**2
R_Squared = (SST2 - SSE2)/SST2 #0.8922 is close to 1 -> Good Fit
R_Correlation = sqrt(R_Squared) #Positive Correlation
#b -> Check Assumptions
plot(lm.out3)
lm.out4 = lm(log(D$time)~D$queries) #Apply Linear Regression
summary(lm.out4) #Check Coefficients (Intercept and Slope)
plot(log(D$time)~D$queries)
abline(lm.out4) #y=1.64859+0.07004x -> Plot Regression Line
plot(lm.out4)
plot(lm.out4)
#y=a*(b**x)
#ln(y)=ln(a*(b**x))
#ln(y)=ln(a)+ln(b**x)
#ln(y)=ln(a)+ln(b)x
#y'=a'+b'x, a'=1.64859, b'=0.07004
a_dash=1.64859
b_dash=0.07004
#y=e**a'+e**(b'x)
#y=e**a'+(e**b')**x
#a=e**a', b=e**b'
a=exp(a_dash)
b=exp(b_dash)
#y=a*(b**x)
#y=5.199643*(1.072551**x)
plot(D$time~D$queries)
curve(5.199643*(1.072551**x), add=TRUE) #y=5.199643*(1.072551**x) -> Plot Regression Curve
