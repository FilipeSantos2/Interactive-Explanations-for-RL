library(extRemes)
####
library(evd)
###
library(fExtremes)
##
##GUMBEL METHOD##
#
#Fitting a FRech?t distribution
#########
y = revd(100,loc=4,scale=1,shape=0.3)
par(mar=rep(2,4))
##histogram##
hist(y,prob=T,ylim=c(0,0.3),xlab="y",main="GEV",ylab="Freq",font=2,family="serif"
,font.lab=2,cex.lab=1.5)
##QQ-plot+empirical_density##
fit = fevd(y,type="GEV")
plot(fit)
##estimates MLE##
summary(fit)
##estimates PWM##
out1<-gevFit(y,type="pwm")
out1
#high quantile order 0.99 of GEV##
##is exceeded only once in 100 years !!##
qevd(0.99,3.98,0.98,0.31,type="GEV")
#high quantile order 0.99 of GEV##
##is exceeded only once in 100 years !!##
qevd(0.99,4.00,1.02,0.37,type="GEV")
#probability of high quantile 10 being exceeded##
## that is P(M>10)##
a=pevd(16.36463,4.00,1.02,0.37,type="GEV") #Change to match the previous point
a
#Return period of high quantile 10#
TR1=1/(1-a)
TR1
###
#Fitting a Weibull distribution
#####
w = revd(100,loc=4,scale=0.5,shape=-0.6)
par(mar=rep(2,4))
hist(w,prob=T,ylim=c(0,0.9),xlab="w",main="GEV",ylab="Freq",font=2,family="serif"
,font.lab=2,cex.lab=1.5)
fit2 = fevd(w,type="GEV")
summary(fit2)
plot(fit2)
out2<-gevFit(w,type="pwm")
out2
qevd(0.99,4.01,0.42,-0.51,type="GEV")
qevd(0.99,4.01,0.42,-0.51,type="GEV")
b=pevd(4.75,4.01,0.42,-0.51,type="GEV")
b
TR2=1/(1-b)
TR2
####
#Normal Distribution)
#######
z = rnorm(1000,10,3)
hist(z,prob=T,ylim=c(0,0.2),xlab="z",main="Normal Distribution",ylab="Freq",font=2,family="serif"
,font.lab=2,cex.lab=1.5)
qnorm(0.75,10,3)
#####
#Fitting a GP distribution (threshold=quantile(0.75))
#####
fitGP = fevd(z,type="GP", threshold = 12)
summary(fitGP)
plot(fitGP)
qevd(0.99,0,2.29,-0.23,type="GP")
pevd(6.5,0,2.29,-0.23,type="GP")
d=pevd(6.5,0,2.29,-0.23,type="GP")
d
d
TR3=1/(1-d)
TR3
